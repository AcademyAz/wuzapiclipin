# Configure these values in Dokploy's Environment tab.

# Required secrets. Leave empty until strong values are generated.
# WUZAPI_ADMIN_TOKEN: openssl rand -hex 32
# WUZAPI_GLOBAL_ENCRYPTION_KEY: openssl rand -hex 16
# WUZAPI_GLOBAL_HMAC_KEY: openssl rand -hex 32
# DB_PASSWORD: openssl rand -hex 24
WUZAPI_ADMIN_TOKEN=
WUZAPI_GLOBAL_ENCRYPTION_KEY=
WUZAPI_GLOBAL_HMAC_KEY=
DB_PASSWORD=

# Optional global webhook. Per-instance webhooks can be configured through the API.
WUZAPI_GLOBAL_WEBHOOK=

# Webhook delivery
WEBHOOK_FORMAT=json
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_COUNT=5
WEBHOOK_RETRY_DELAY_SECONDS=30
WUZAPI_WEBHOOK_USE_PROXY=false

# Session
SESSION_DEVICE_NAME=ClipIn
TZ=America/Sao_Paulo

# PostgreSQL
DB_USER=wuzapi
DB_NAME=wuzapi
DB_SSLMODE=false
